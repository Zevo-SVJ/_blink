# dependencies
node_modules

# build
dist
dist-ssr

# env
.env
*.local

# Native
ios/
android/
core

# Expo
.expo

# test artifacts (regenerated by `vitest --config vitest.browser.config.ts`)
.vitest-attachments/
src/test/__screenshots__/

# QA screenshots (regenerated by the harnesses in qa/)
qa/shots/
# Film stills and contact sheets (regenerated by `npm run video:stills`)
qa/film/
qa/mp4/

# `video/` is deliberately NOT ignored. The 1080x1920 masters live there and
# are committed, because they are the thing that gets uploaded to TikTok and
# Reels — somebody should be able to download them from the repository
# without installing Node and running a render. They are regenerable with
# `npm run video:render` if they ever need to be rebuilt.

# debug
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# macOS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Remotion's bundle cache
.remotion
